{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@spenditure/types": ["../../packages/types/src"],
      "@spenditure/utils": ["../../packages/utils/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
