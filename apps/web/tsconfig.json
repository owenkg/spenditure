{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@spenditure/types": ["../../packages/types/src"],
      "@spenditure/utils": ["../../packages/utils/src"],
      "~/*": ["./app/*"]
    }
  },
  "include": ["app", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
